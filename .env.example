# Copy to .env and fill in. Never commit .env.
# The owner's full-access key is NEVER configured here: owner actions are signed in the
# owner's own wallet. Services only hold the function-call keys they generated locally.

# ── NEAR ──────────────────────────────────────────────────────────────────────────────────────
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

OWNER_ACCOUNT_ID=yourbusiness.near
POLICY_CONTRACT_ID=getleash.yourbusiness.near
AGENT_ACCOUNT_ID=agent-1.yourbusiness.near
EXECUTOR_ACCOUNT_ID=executor-1.yourbusiness.near

# Native USDC on NEAR mainnet (docs/verified-facts.md)
USDC_CONTRACT_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# Function-call keys, generated by each service on its own machine (ed25519:...)
AGENT_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=

# ── NEAR AI Cloud (private inference) ─────────────────────────────────────────────────────────
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=

# ── NEAR Intents 1Click ───────────────────────────────────────────────────────────────────────
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Partner JWT from https://partners.near-intents.org, sent as X-API-Key (Distribution Channel key)
ONECLICK_JWT=

# ── Telegram ingestion ────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric ids
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# HMAC key for obligation ids: 32+ random bytes, hex (openssl rand -hex 32)
TENANT_SECRET=
# Owner chat for executor notices (approval and signature links, payout and swap results)
TELEGRAM_OWNER_CHAT_ID=

# AES-256-GCM key for the encrypted invoice store (openssl rand -hex 32)
INVOICE_STORE_KEY=
# Optional: pin a NEAR-hosted model id; a pinned model is never swapped. Default: Qwen/Qwen3.8-27B,
# then the next live NEAR-hosted model if it does not answer (docs/decisions.md D-24)
NEAR_AI_MODEL=

# Dashboard base URL used in approval links
DASHBOARD_URL=http://localhost:3000
